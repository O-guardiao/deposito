# Variáveis de ambiente aceitas pelo fisio. O app NÃO lê este arquivo:
# exporte no shell (ex.: `export FISIO_ADDR=...`) ou use as flags equivalentes.
# Todas são opcionais.
FISIO_ADDR=127.0.0.1:8080
FISIO_DEMO=0
FISIO_DATA=./data
FISIO_CREDENTIALS=./credentials.json
# FISIO_TOKEN=./data/token.json
# FISIO_SPREADSHEET_ID=        # vazio: cria "Fisio - Pacientes" na 1ª vez e guarda o ID em data/fisio.json
FISIO_CALENDAR_ID=primary
FISIO_TZ=America/Sao_Paulo
# FISIO_PUBLIC_URL=http://localhost:8080   # precisa bater com o redirect cadastrado no Google Cloud
